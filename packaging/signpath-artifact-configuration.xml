<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration for SignPath: which files in the unsigned artifact
  (the contents of dist/anonymate-gui, uploaded by .github/workflows/release.yml) get signed.
  SignPath keeps its own copy: paste this into the project's artifact configuration there,
  and keep both the same.

  Only our own two exe's are signed. The DLLs PyInstaller bundles (Python, Qt, DuckDB) come
  from others; the SignPath Foundation only signs a project's own code.
  The product name and version must match those written by packaging/versionfile.py.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="anonymate.exe" product-name="AnonyMate" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="anonymate-gui.exe" product-name="AnonyMate" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
